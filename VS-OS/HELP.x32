origin 0x00040000 ; SHELL.BIN loads this file at this address
ldi r0, help_msg
ldi r1, 1
call sys_kprint
ret



help_msg:
  db "Command List\n"
  db " help   | Print this menu\n"
  db " dir    | List files and disk information\n"
  db " clear  | Clears the screen\n"
  db " run    | Run application files\n"
  db " echo   | Echoes what you type back at you"

  db 0

